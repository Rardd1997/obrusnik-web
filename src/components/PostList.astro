---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { getSortedPosts } from '../utils/taxonomy';
import { getReadingTime } from '../utils/readingTime';

interface Props {
	/** Posts to render. Defaults to all blog posts, newest first. */
	posts?: CollectionEntry<'blog'>[];
}

const { posts = await getSortedPosts() } = Astro.props;

const [featured, ...rest] = posts;
const readingTime = (post: CollectionEntry<'blog'>) => getReadingTime(post.body ?? '');
---

<section class="post-grid">
	{
		featured && (
			<a class="featured" href={`/blog/${featured.id}/`}>
				<div class="featured-text">
					<p class="meta">
						<FormattedDate date={featured.data.pubDate} />
						<span class="dot">•</span>
						{readingTime(featured)} min read
					</p>
					<h2 class="featured-title">
						{featured.data.title}
						<span class="arrow" aria-hidden="true">›</span>
					</h2>
					<p class="excerpt">{featured.data.description}</p>
				</div>
				<div class="media featured-media">
					{featured.data.category && <span class="cat-chip">{featured.data.category}</span>}
					{featured.data.blogImage && (
						<img
							src={featured.data.blogImage.src}
							alt=""
							loading="eager"
							fetchpriority="high"
						/>
					)}
				</div>
			</a>
		)
	}

	<div class="cards">
		{
			rest.map((post) => (
				<a class="card" href={`/blog/${post.id}/`}>
					<div class="media card-media">
						{post.data.category && <span class="cat-chip">{post.data.category}</span>}
						{post.data.blogImage && (
							<img src={post.data.blogImage.src} alt="" loading="lazy" />
						)}
					</div>
					<div class="card-body">
						<p class="meta">
							<FormattedDate date={post.data.pubDate} />
							<span class="dot">•</span>
							{readingTime(post)} min read
						</p>
						<h3 class="card-title">
							{post.data.title}
							<span class="arrow" aria-hidden="true">›</span>
						</h3>
						<p class="excerpt">{post.data.description}</p>
					</div>
				</a>
			))
		}
	</div>
</section>

<style>
	.post-grid {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	/* Shared card chrome */
	.featured,
	.card {
		display: block;
		text-decoration: none;
		color: inherit;
		background: var(--surface);
		border-radius: 16px;
		box-shadow: 0 1px 2px rgba(var(--gray), 0.18);
		overflow: hidden;
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}
	.featured:hover,
	.card:hover {
		box-shadow: var(--box-shadow);
		transform: translateY(-2px);
	}

	/* Image media wrapper */
	.media {
		position: relative;
		overflow: hidden;
		background: rgb(var(--gray-light));
	}
	.media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
	}

	/* Category pill overlaid on the image */
	.cat-chip {
		position: absolute;
		top: 0.85rem;
		left: 0.85rem;
		z-index: 1;
		padding: 0.3em 0.85em;
		border-radius: 8px;
		background: var(--surface);
		color: rgb(var(--black));
		font-size: 0.8rem;
		font-weight: 600;
		line-height: 1.4;
		box-shadow: 0 1px 3px rgba(var(--gray), 0.3);
		white-space: nowrap;
	}

	.meta {
		margin: 0 0 0.6rem;
		color: rgb(var(--gray));
		font-size: 0.85rem;
	}
	.meta .dot {
		margin: 0 0.4em;
	}

	.excerpt {
		margin: 0;
		color: rgb(var(--gray-dark));
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.arrow {
		display: inline-block;
		font-weight: 400;
		transition: transform 0.2s ease;
	}
	.featured:hover .arrow,
	.card:hover .arrow {
		transform: translateX(4px);
	}

	/* --- Featured (hero) --- */
	.featured {
		display: grid;
		grid-template-columns: 1fr 1.15fr;
		align-items: stretch;
	}
	.featured-text {
		padding: 2.5rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.featured-title {
		margin: 0 0 1rem;
		font-size: 2.2rem;
		line-height: 1.15;
		color: rgb(var(--black));
	}
	.featured-media {
		min-height: 360px;
	}

	/* --- Card grid --- */
	.cards {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}
	.card {
		display: flex;
		flex-direction: column;
	}
	.card-media {
		aspect-ratio: 16 / 9;
	}
	.card-body {
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		flex: 1;
	}
	.card-title {
		margin: 0 0 0.75rem;
		font-size: 1.2rem;
		line-height: 1.25;
		color: rgb(var(--black));
	}

	@media (max-width: 1100px) {
		.cards {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 820px) {
		.featured {
			grid-template-columns: 1fr;
		}
		.featured-text {
			padding: 1.75rem;
			order: 2;
		}
		.featured-media {
			order: 1;
			min-height: 0;
			aspect-ratio: 16 / 9;
		}
		.featured-title {
			font-size: 1.7rem;
		}
	}
	@media (max-width: 520px) {
		.cards {
			grid-template-columns: 1fr;
		}
	}
</style>
