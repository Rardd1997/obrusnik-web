---
/**
 * Vertical share rail for a blog post. The native button uses the Web Share
 * API when available (falling back to copy-link); the social links are wired
 * to the current page URL on the client so they work regardless of the
 * configured `site` URL.
 */
---

<div class="share" data-share>
	<button class="share-btn native" type="button" data-native aria-label="Share this post">
		<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
			<path
				fill="currentColor"
				d="M3.5 6a.5.5 0 0 0-.5.5v8a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-8a.5.5 0 0 0-.5-.5h-2a.5.5 0 0 1 0-1h2A1.5 1.5 0 0 1 14 6.5v8a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 14.5v-8A1.5 1.5 0 0 1 3.5 5h2a.5.5 0 0 1 0 1h-2z"
			></path>
			<path
				fill="currentColor"
				d="M7.646.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 1.707V10.5a.5.5 0 0 1-1 0V1.707L5.354 3.854a.5.5 0 1 1-.708-.708l3-3z"
			></path>
		</svg>
		<span class="sr-only">Share this post</span>
	</button>
	<a class="share-btn fb" data-fb href="#" target="_blank" rel="noopener" aria-label="Share on Facebook">
		<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
			<path
				fill="currentColor"
				d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z"
			></path>
		</svg>
		<span class="sr-only">Share on Facebook</span>
	</a>
	<a class="share-btn x" data-x href="#" target="_blank" rel="noopener" aria-label="Share on X">
		<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
			<path
				fill="currentColor"
				d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.6.75Zm-.86 13.028h1.36L4.323 2.145H2.865l8.875 11.633Z"
			></path>
		</svg>
		<span class="sr-only">Share on X</span>
	</a>
	<a class="share-btn li" data-li href="#" target="_blank" rel="noopener" aria-label="Share on LinkedIn">
		<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
			<path
				fill="currentColor"
				d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"
			></path>
		</svg>
		<span class="sr-only">Share on LinkedIn</span>
	</a>
</div>

<style>
	.share {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}
	.share-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		border: none;
		border-radius: 50%;
		cursor: pointer;
		color: #fff;
		text-decoration: none;
		transition: transform 0.15s ease, opacity 0.15s ease;
	}
	.share-btn:hover {
		transform: translateY(-2px);
		opacity: 0.9;
	}
	.native {
		background: rgb(var(--gray-dark));
	}
	.fb {
		background: #1877f2;
	}
	.x {
		background: #000;
	}
	.li {
		background: #0a66c2;
	}
	.native.copied {
		background: #2e7d32;
	}
</style>

<script>
	function initShare() {
		const root = document.querySelector<HTMLElement>('[data-share]');
		if (!root) return;

		const url = encodeURIComponent(window.location.href);
		const title = encodeURIComponent(document.title);

		const fb = root.querySelector<HTMLAnchorElement>('[data-fb]');
		if (fb) fb.href = `https://www.facebook.com/sharer/sharer.php?u=${url}`;
		const x = root.querySelector<HTMLAnchorElement>('[data-x]');
		if (x) x.href = `https://twitter.com/intent/tweet?url=${url}&text=${title}`;
		const li = root.querySelector<HTMLAnchorElement>('[data-li]');
		if (li) li.href = `https://www.linkedin.com/sharing/share-offsite/?url=${url}`;

		const native = root.querySelector<HTMLButtonElement>('[data-native]');
		if (native) {
			native.addEventListener('click', async () => {
				if (navigator.share) {
					try {
						await navigator.share({ title: document.title, url: window.location.href });
					} catch {
						/* user dismissed the share sheet */
					}
					return;
				}
				try {
					await navigator.clipboard.writeText(window.location.href);
					native.classList.add('copied');
					setTimeout(() => native.classList.remove('copied'), 1500);
				} catch {
					/* clipboard unavailable */
				}
			});
		}
	}

	initShare();
	document.addEventListener('astro:page-load', initShare);
</script>
