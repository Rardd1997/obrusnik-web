---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Comments from '../components/Comments.astro';
import Taxonomy from '../components/Taxonomy.astro';
import ListenToPost from '../components/ListenToPost.astro';
import ShareButtons from '../components/ShareButtons.astro';

type Props = CollectionEntry<'blog'>['data'] & { readingTime: number };

const { title, description, pubDate, updatedDate, blogImage, category, tags, readingTime } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}

			/* --- Hero --- */
			.post-hero {
				background: linear-gradient(135deg, #eef2fc 0%, #e8edfb 50%, #f2eef9 100%);
				border-bottom: 1px solid rgba(var(--gray), 0.25);
			}
			.hero-inner {
				width: 1200px;
				max-width: calc(100% - 3em);
				margin: 0 auto;
				padding: 3rem 0;
				display: grid;
				grid-template-columns: 1fr 1.1fr;
				gap: 2.5rem;
				align-items: center;
			}
			.hero-text {
				min-width: 0;
			}
			.hero-meta {
				margin: 0 0 1rem;
				color: rgb(var(--gray-dark));
				font-size: 0.9rem;
			}
			.hero-meta .dot {
				margin: 0 0.4em;
			}
			.hero-text h1 {
				margin: 0 0 1rem;
				font-size: 2.7rem;
				line-height: 1.1;
			}
			.last-updated-on {
				font-style: italic;
			}
			.hero-media img {
				display: block;
				width: 100%;
				border-radius: 14px;
				box-shadow: var(--box-shadow);
			}

			/* --- Body: share rail + prose --- */
			.post-body {
				width: 1100px;
				max-width: calc(100% - 3em);
				margin: 0 auto;
				padding: 3rem 0 1rem;
			}
			.body-inner {
				display: grid;
				grid-template-columns: 200px minmax(0, 1fr);
				gap: 2.5rem;
				align-items: start;
			}
			.post-aside {
				position: sticky;
				top: 1.5rem;
			}
			.prose {
				min-width: 0;
				color: rgb(var(--gray-dark));
			}

			@media (max-width: 900px) {
				.hero-inner {
					grid-template-columns: 1fr;
					gap: 1.75rem;
					padding: 2.25rem 0;
				}
				.hero-media {
					order: -1;
				}
				.hero-text h1 {
					font-size: 2rem;
				}
				.body-inner {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}
				.post-aside {
					position: static;
				}
				.post-body {
					padding-top: 2rem;
				}
			}
		</style>
		<style is:global>
			/* Warm hero gradient toned down for dark mode. */
			html[data-theme='dark'] .post-hero {
				background: linear-gradient(135deg, #1b1e2b 0%, #1d2030 50%, #231f31 100%);
			}
			/* Taxonomy centers its chips by default; keep them left-aligned in the hero. */
			.hero-text .taxonomy {
				justify-content: flex-start;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="post-hero">
					<div class="hero-inner">
						<div class="hero-text">
							<p class="hero-meta">
								<FormattedDate date={pubDate} />
								<span class="dot">•</span>
								{readingTime} min read
								{
									updatedDate && (
										<span class="last-updated-on">
											{' '}— updated <FormattedDate date={updatedDate} />
										</span>
									)
								}
							</p>
							<h1>{title}</h1>
							<Taxonomy category={category} tags={tags} />
							<ListenToPost />
						</div>
						<div class="hero-media">
							{blogImage && <img width={960} height={540} src={blogImage.src} alt="" loading="eager" fetchpriority="high" />}
						</div>
					</div>
				</header>

				<div class="post-body">
					<div class="body-inner">
						<aside class="post-aside">
							<ShareButtons />
						</aside>
						<div class="prose">
							<div id="post-content">
								<slot />
							</div>
							<Comments />
						</div>
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
